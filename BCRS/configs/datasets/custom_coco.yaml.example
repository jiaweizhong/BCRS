name: my_dataset
root: ${MY_DATASET_ROOT:-../../data/my_dataset}
num_classes: 3
classes: [class_a, class_b, class_c]

# CEASC and QueryDet consume COCO JSON. QueryDet's copied loader expects
# contiguous category IDs 1..num_classes. ESOD consumes YOLO labels alongside
# each image (images/... -> labels/...) and can use a directory or list file.
splits:
  train:
    images: images/train
    annotations: annotations/train.json
  val:
    images: images/val
    annotations: annotations/val.json
  test:
    images: images/test
    annotations: annotations/test.json

adapters:
  esod: {}
  querydet:
    runner: visdrone
  ceasc:
    dataset_type: CocoDataset
